# Copy to infra/.env (never commit it). Read by docker compose.

# DuckDNS subdomains, all pointing at the instance's public IP
API_DOMAIN=letopeiras.duckdns.org
LIVEKIT_DOMAIN=letopeiras-lk.duckdns.org
TURN_DOMAIN=letopeiras-turn.duckdns.org

# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=voce@example.com

# LiveKit API key pair, shared by LiveKit and the server.
# Generate the secret with: openssl rand -base64 48 | tr -d '\n='
LIVEKIT_API_KEY=letopeiras
LIVEKIT_API_SECRET=

LOG_LEVEL=info
