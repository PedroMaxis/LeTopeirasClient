# Server the app talks to. Defaults: http://127.0.0.1:3000 in dev, https://letopeiras.duckdns.org in builds.
# VITE_SERVER_URL=http://127.0.0.1:3000

# LiveKit signaling URL the server hands out (LIVEKIT_URL on the server). Only used to build
# the renderer's Content-Security-Policy; voice is blocked if it doesn't match.
# Default: wss://letopeiras-lk.duckdns.org (local servers on 127.0.0.1 are allowed in dev).
# VITE_LIVEKIT_URL=ws://127.0.0.1:7880
