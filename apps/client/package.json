{
  "name": "@letopeiras/client",
  "productName": "LeTopeiras Client",
  "version": "0.4.0",
  "private": true,
  "description": "LeTopeiras Client",
  "author": "LeTopeiras",
  "homepage": "https://github.com/PedroMaxis/LeTopeirasClient",
  "desktopName": "letopeiras-client.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && pnpm --filter @letopeiras/audio-capture ensure && electron-vite dev",
    "build": "electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dist:win": "pnpm --filter @letopeiras/audio-capture ensure && electron-vite build && electron-builder --win --publish never",
    "release:win": "pnpm --filter @letopeiras/audio-capture ensure && electron-vite build && electron-builder --win --publish always",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "release:linux": "electron-vite build && electron-builder --linux --publish always",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@letopeiras/shared": "workspace:*",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "emojibase": "^18.0.0",
    "emojibase-data": "^18.0.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "livekit-client": "^2.22.3",
    "lowlight": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
