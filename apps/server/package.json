{
  "name": "@letopeiras/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "create-admin": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "argon2": "^0.45.1",
