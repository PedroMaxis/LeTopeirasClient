    "fastify": "^5.12.5",
    "livekit-server-sdk": "^2.19.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@letopeiras/shared": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
