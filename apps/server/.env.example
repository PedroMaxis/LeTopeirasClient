# Address the HTTP server binds to (use 0.0.0.0 inside Docker)
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/letopeiras.db
# true when running behind Caddy, so rate limits see the real client IP
TRUST_PROXY=false
SESSION_TTL_DAYS=30
LOG_LEVEL=info

# Public LiveKit URL handed to clients (wss://letopeiras-lk.duckdns.org in production)
LIVEKIT_URL=ws://127.0.0.1:7880
# URL the server uses to call the LiveKit API (http://livekit:7880 inside Docker)
LIVEKIT_API_URL=http://127.0.0.1:7880
# Must match the LiveKit server keys (devkey/secret for `livekit-server --dev`)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
